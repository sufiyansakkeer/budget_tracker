<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded track and fill. Android 12+ tints both with the palette and the
     status tone; older versions keep these neutral defaults. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_track" />
            <corners android:radius="@dimen/widget_pill_radius" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/widget_muted" />
                <corners android:radius="@dimen/widget_pill_radius" />
            </shape>
        </clip>
    </item>
</layer-list>
