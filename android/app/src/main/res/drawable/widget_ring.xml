<?xml version="1.0" encoding="utf-8"?>
<!-- Today's target as a ring, like the app's: the track is the whole target
     and the arc is what has been spent, from the top, clockwise. Android 12+
     tints both with the palette and the status tone. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape
            android:innerRadiusRatio="2.5"
            android:shape="ring"
            android:thicknessRatio="10"
            android:useLevel="false">
            <solid android:color="@color/widget_track" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <rotate
            android:fromDegrees="270"
            android:pivotX="50%"
            android:pivotY="50%"
            android:toDegrees="270">
            <shape
                android:innerRadiusRatio="2.5"
                android:shape="ring"
                android:thicknessRatio="10"
                android:useLevel="true">
                <solid android:color="@color/widget_muted" />
            </shape>
        </rotate>
    </item>
</layer-list>
