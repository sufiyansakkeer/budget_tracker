<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar (small) notification icon for Monivo.

  Android renders small icons as an alpha mask and tints them itself, so this
  must be a single-colour, transparent-background silhouette. It is a
  simplified monochrome version of the launcher artwork (a hexagonal wallet
  with a clasp): a stroked rounded hexagon plus a solid clasp with a punched
  coin hole. Being a vector, it stays crisp at every density and API level
  (minSdk 23), and there is no coloured/opaque background to become a square.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">

    <!-- Rounded hexagon outline (wallet body) -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.2"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M12,2.6
            L19.4,6.9
            Q20.4,7.5 20.4,8.6
            L20.4,15.4
            Q20.4,16.5 19.4,17.1
            L12,21.4
            L4.6,17.1
            Q3.6,16.5 3.6,15.4
            L3.6,8.6
            Q3.6,7.5 4.6,6.9
            Z" />

    <!-- Clasp: solid rounded rectangle overlapping the right edge, with a
         punched circular hole (even-odd) standing in for the coin dot. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M15.2,9.2
            L21,9.2
            Q22.6,9.2 22.6,10.8
            L22.6,13.2
            Q22.6,14.8 21,14.8
            L15.2,14.8
            Q13.6,14.8 13.6,13.2
            L13.6,10.8
            Q13.6,9.2 15.2,9.2
            Z
            M18.1,10.7
            A1.3,1.3 0 1,0 18.1,13.3
            A1.3,1.3 0 1,0 18.1,10.7
            Z" />
</vector>
