<?xml version="1.0" encoding="utf-8"?>
<!-- Smallest slots and largest text. The amount fills the space it has
     (measured at widget_text_hero_floor); the label goes first, then the
     minor units. Only in the very last resort does the amount shrink below
     the font-size setting, so that it is never cut off. The whole sentence
     is the content description. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    android:textDirection="ltr">

    <ImageView
        android:id="@+id/widget_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_surface"
        android:tint="@color/widget_surface" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="@dimen/widget_pad_h_compact"
        android:paddingTop="@dimen/widget_gap_md"
        android:paddingEnd="@dimen/widget_pad_h_compact"
        android:paddingBottom="@dimen/widget_gap_md">

        <LinearLayout
            android:id="@+id/widget_label_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_status_dot"
                android:layout_width="@dimen/widget_dot"
                android:layout_height="@dimen/widget_dot"
                android:layout_marginEnd="@dimen/widget_gap_md"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_circle"
                android:tint="@color/widget_neutral" />

            <TextView
                android:textDirection="ltr"
                android:id="@+id/widget_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textColor="@color/widget_muted"
                android:textSize="@dimen/widget_text_label" />
        </LinearLayout>

        <!-- Auto-sized within a definite height: measured at its floor size,
             it grows to fill the slot. -->
        <TextView
            android:textDirection="ltr"
            android:id="@+id/widget_amount"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="@dimen/widget_text_hero_compact"
            android:autoSizeMinTextSize="@dimen/widget_text_last_resort"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:fontFeatureSettings="tnum"
            android:gravity="center_vertical|start"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_ink"
            android:textSize="@dimen/widget_text_hero_floor"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
