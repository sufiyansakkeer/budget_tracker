<?xml version="1.0" encoding="utf-8"?>
<!-- Wide, short slots: the amount, what it is and its status beside Add
     expense; what is left today joins them when the slot is wide enough, and
     the status line goes (its dot stays) when the slot is very short. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    android:textDirection="ltr">

    <ImageView
        android:id="@+id/widget_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_surface"
        android:tint="@color/widget_surface" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/widget_pad_h"
        android:paddingTop="@dimen/widget_pad_v_compact"
        android:paddingEnd="@dimen/widget_pad_h"
        android:paddingBottom="@dimen/widget_pad_v_compact">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_status_dot"
                    android:layout_width="@dimen/widget_dot"
                    android:layout_height="@dimen/widget_dot"
                    android:layout_marginEnd="@dimen/widget_gap_md"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_circle"
                    android:tint="@color/widget_neutral" />

                <TextView
                    android:textDirection="ltr"
                    android:id="@+id/widget_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_muted"
                    android:textSize="@dimen/widget_text_label" />
            </LinearLayout>

            <TextView
                android:textDirection="ltr"
                android:id="@+id/widget_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/widget_gap_xs"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:textSize="@dimen/widget_text_hero_row"
                android:textStyle="bold" />

            <TextView
                android:textDirection="ltr"
                android:id="@+id/widget_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/widget_gap_xs"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:textSize="@dimen/widget_text_caption" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:id="@+id/widget_metrics"
            android:layout_marginStart="@dimen/widget_gap_xl"
            android:orientation="vertical">

            <TextView
                android:textDirection="ltr"
                android:id="@+id/widget_rest_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_muted"
                android:textSize="@dimen/widget_text_caption" />

            <TextView
                android:textDirection="ltr"
                android:id="@+id/widget_rest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/widget_gap_xs"
                android:gravity="end"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:textSize="@dimen/widget_text_value" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_add"
            android:layout_width="@dimen/widget_icon_button"
            android:layout_height="@dimen/widget_icon_button"
            android:layout_marginStart="@dimen/widget_gap_xl"
            android:contentDescription="@string/widget_add_expense">

            <ImageView
                android:id="@+id/widget_add_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_circle"
                android:scaleType="fitXY"
                android:tint="@color/widget_accent" />

            <ImageView
                android:id="@+id/widget_add_icon"
                android:layout_width="@dimen/widget_icon"
                android:layout_height="@dimen/widget_icon"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_add"
                android:tint="@color/widget_on_accent" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
