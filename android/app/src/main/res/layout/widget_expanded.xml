<?xml version="1.0" encoding="utf-8"?>
<!-- Large slots: the budget, the amount with its status, today's spending
     against it, the budget left with its track, and Add expense. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    android:textDirection="ltr">

    <ImageView
        android:id="@+id/widget_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_surface"
        android:tint="@color/widget_surface" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/widget_pad_h_large"
        android:paddingTop="@dimen/widget_pad_v_large"
        android:paddingEnd="@dimen/widget_pad_h_large"
        android:paddingBottom="@dimen/widget_pad_v_large">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:textDirection="ltr"
                android:id="@+id/widget_budget"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:textSize="@dimen/widget_text_label" />

            <TextView
                android:textDirection="ltr"
                android:id="@+id/widget_days_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/widget_gap_md"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_muted"
                android:textSize="@dimen/widget_text_caption" />
        </LinearLayout>

        <TextView
            android:textDirection="ltr"
            android:id="@+id/widget_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_gap_lg"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textColor="@color/widget_muted"
            android:textSize="@dimen/widget_text_label" />

        <TextView
            android:textDirection="ltr"
            android:id="@+id/widget_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_gap_xs"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_ink"
            android:textSize="@dimen/widget_text_hero_large"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_gap_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_status_dot"
                android:layout_width="@dimen/widget_dot"
                android:layout_height="@dimen/widget_dot"
                android:layout_marginEnd="@dimen/widget_gap_md"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_circle"
                android:tint="@color/widget_neutral" />

            <TextView
                android:textDirection="ltr"
                android:id="@+id/widget_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textColor="@color/widget_ink"
                android:textSize="@dimen/widget_text_body" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/widget_today_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_track"
            android:layout_marginTop="@dimen/widget_gap_lg"
            android:importantForAccessibility="no"
            android:indeterminate="false"
            android:max="1000"
            android:maxHeight="@dimen/widget_track"
            android:minHeight="@dimen/widget_track"
            android:progressDrawable="@drawable/widget_progress" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_gap_md"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:textDirection="ltr"
                    android:id="@+id/widget_spent_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_muted"
                    android:textSize="@dimen/widget_text_caption" />

                <TextView
                    android:textDirection="ltr"
                    android:id="@+id/widget_spent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/widget_gap_xs"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_ink"
                    android:textSize="@dimen/widget_text_value" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:layout_marginStart="@dimen/widget_gap_lg"
                android:orientation="vertical">

                <TextView
                    android:textDirection="ltr"
                    android:id="@+id/widget_rest_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_muted"
                    android:textSize="@dimen/widget_text_caption" />

                <TextView
                    android:textDirection="ltr"
                    android:id="@+id/widget_rest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/widget_gap_xs"
                    android:gravity="end"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_ink"
                    android:textSize="@dimen/widget_text_value" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_divider"
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_hairline"
            android:layout_marginTop="@dimen/widget_gap_lg"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_hairline"
            android:tint="@color/widget_divider" />

        <TextView
            android:textDirection="ltr"
            android:id="@+id/widget_budget_left"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_gap_lg"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textColor="@color/widget_ink"
            android:textSize="@dimen/widget_text_body" />

        <ProgressBar
            android:id="@+id/widget_budget_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_track_thin"
            android:layout_marginTop="@dimen/widget_gap_md"
            android:importantForAccessibility="no"
            android:indeterminate="false"
            android:max="1000"
            android:maxHeight="@dimen/widget_track_thin"
            android:minHeight="@dimen/widget_track_thin"
            android:progressDrawable="@drawable/widget_progress" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/widget_add"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_gap_lg"
            android:contentDescription="@string/widget_add_expense"
            android:minHeight="@dimen/widget_button_height">

            <ImageView
                android:id="@+id/widget_add_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_pill"
                android:tint="@color/widget_accent" />

            <!-- match_parent, so the FrameLayout stretches the fill behind it
                 (it re-measures match_parent children only when there are two). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="@dimen/widget_gap_lg"
                android:paddingTop="@dimen/widget_gap_md"
                android:paddingEnd="@dimen/widget_gap_xl"
                android:paddingBottom="@dimen/widget_gap_md">

                <ImageView
                    android:id="@+id/widget_add_icon"
                    android:layout_width="@dimen/widget_icon_small"
                    android:layout_height="@dimen/widget_icon_small"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_add"
                    android:tint="@color/widget_on_accent" />

                <TextView
                    android:textDirection="ltr"
                    android:id="@+id/widget_add_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/widget_gap_sm"
                    android:importantForAccessibility="no"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_add_expense"
                    android:textColor="@color/widget_on_accent"
                    android:textSize="@dimen/widget_text_button" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
