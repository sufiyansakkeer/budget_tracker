+// Patched for React Native 0.87+.
+//
+// RN 0.87 compiles with RCT_REMOVE_LEGACY_ARCH=1, which removed the RCTCxxBridge
+// class and RCTBridge's `runtime` property, so the jsi::Runtime can no longer be
+// reached from an RCTBridge. The new-arch replacement hook,
+// -installJSIBindingsWithRuntime:callInvoker:, is only invoked by
+// RCTTurboModuleManager's provideTurboModule: for codegen TurboModules — never by
+// provideLegacyModule:, which is the path WMDatabaseBridge (a plain
+// RCTBridgeModule) takes. There is therefore no supported way to install the JSI
+// adapter until WatermelonDB ships a codegen TurboModule.
+//
+// Installing nothing is safe: `global.nativeWatermelonCreateAdapter` stays
+// undefined, so initializeJSI() in adapters/sqlite/makeDispatcher/index.native.js
+// evaluates to false and WatermelonDB transparently uses the async bridge
+// dispatcher, which is the default (experimentalUseJSI is opt-in).
+extern "C" void installWatermelonJSI(RCTBridge *bridge) {
+    (void) bridge;
 }
